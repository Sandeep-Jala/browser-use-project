# Sample environment file. Copy to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is gitignored (holds secrets); this `.env.example` is committed as the template.

# ---- Login (consumed by browser/login.py) ----
LOGIN_URL=https://your-app.example.com/login
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=your-password-here

# ---- LLM provider ----
# "azure" (default) or "groq".
LLM_PROVIDER=azure

# Azure OpenAI (OpenAI-compatible /openai/v1 endpoint): drives the agent AND the expander + judge.
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-4.1-mini

# Groq (only needed when LLM_PROVIDER=groq).
# GROQ_API_KEY=gsk-your-groq-key-here
# GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# ---- Prompt expander (rewrites a terse task into concrete steps before running) ----
EXPAND_PROMPT=true
EXPANDER_MODEL=gpt-4.1-mini

# ---- Agent / telemetry ----
USE_VISION=true
# Image detail sent to the model each step: high | low | auto ("high" = sharper, more tokens).
VISION_DETAIL_LEVEL=auto
# Cap on past steps kept in the agent's context. Must be unset or > 5 (blank = unlimited).
# ~20 balances loop-awareness (too small = the agent repeats failed recoveries it cannot
# remember) against prompt growth (too large = slow, timeout-prone LLM calls).
MAX_HISTORY_ITEMS=20
# HEADFUL=true        # show a visible browser (default: headless)
# CDP_PORT=9222       # Chrome remote-debugging port login.py opens
# ERRORS_DIR=errors   # where failure screenshots go
# ARTIFACTS_DIR=artifacts  # per-run telemetry + HTML reports

# ---- Hybrid subtask engine (pipeline/hybrid.py) ----
# Author/repair tasks subtask-by-subtask against the shared library (LLM only for the
# gaps) instead of one whole-task agent run. ON by default; set false (or pass
# --no-subtasks) to fall back to whole-task authoring.
# SUBTASKS=true
# Agent step budget for ONE subtask segment (whole-task authoring uses 90).
# SUBTASK_MAX_STEPS=25

# ---- Run options (can also be set inline, e.g. `TASK=purchase AUTO=1 uv run python -m automation`) ----
# TASK=invoice         # which task to run: invoice | purchase
# AUTO=1               # replay the recorded script if one exists, else author + record it
# FRESH=1              # force re-authoring even if a script already exists
